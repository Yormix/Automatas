<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F4F8"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- Título -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Simulador de Autómata"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#1A237E"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Lenguaje: a*b"
            android:textSize="15sp"
            android:textColor="#5C6BC0"
            android:layout_marginBottom="20dp"/>

        <!-- Estado actual -->
        <TextView
            android:id="@+id/tvEstadoLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Estado actual:"
            android:textSize="13sp"
            android:textColor="#546E7A"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:id="@+id/tvEstado"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:gravity="center"
            android:text="q0"
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_estado"
            android:layout_marginBottom="20dp"
            android:elevation="4dp"/>

        <!-- Campo de entrada -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ingresa una cadena:"
            android:textSize="14sp"
            android:textColor="#37474F"
            android:layout_marginBottom="6dp"/>

        <EditText
            android:id="@+id/etCadena"
            android:layout_width="280dp"
            android:layout_height="wrap_content"
            android:hint="Ej: aaab"
            android:inputType="text"
            android:textSize="18sp"
            android:textColor="#1A237E"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:background="@drawable/bg_input"
            android:layout_marginBottom="16dp"/>

        <!-- Botones -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="20dp">

            <Button
                android:id="@+id/btnEvaluar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="▶  Evaluar"
                android:textColor="#FFFFFF"
                android:backgroundTint="#3949AB"
                android:layout_marginEnd="12dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"/>

            <Button
                android:id="@+id/btnReset"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="↺  Limpiar"
                android:textColor="#3949AB"
                android:backgroundTint="#E8EAF6"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"/>
        </LinearLayout>

        <!-- Resultado -->
        <TextView
            android:id="@+id/tvResultado"
            android:layout_width="280dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textSize="16sp"
            android:textStyle="bold"
            android:padding="14dp"
            android:visibility="gone"
            android:background="@drawable/bg_resultado"
            android:layout_marginBottom="20dp"/>

        <!-- Log de transiciones -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Registro de transiciones:"
            android:textSize="13sp"
            android:textColor="#546E7A"
            android:layout_marginBottom="6dp"/>

        <TextView
            android:id="@+id/tvLog"
            android:layout_width="320dp"
            android:layout_height="wrap_content"
            android:text="(sin evaluar)"
            android:textSize="13sp"
            android:textColor="#263238"
            android:lineSpacingExtra="4dp"
            android:padding="14dp"
            android:background="@drawable/bg_log"
            android:layout_marginBottom="30dp"
            android:fontFamily="monospace"/>

    </LinearLayout>
</ScrollView>